# Copy to .env.local for local overrides. Never commit real values.

# Canonical URL used by metadata, sitemap, robots and OG images.
# Fallbacks: https://$VERCEL_PROJECT_PRODUCTION_URL (set by Vercel), then http://localhost:3000.
NEXT_PUBLIC_SITE_URL=

# Preview mode: render and link draft projects. Rejected together with CONTENT_STRICT.
SHOW_DRAFTS=

# Production guard: placeholders, missing public files and launch rules break the build.
CONTENT_STRICT=

# Set by Vercel. "production" enables indexing (robots/meta) and Vercel Analytics.
# VERCEL_ENV=
